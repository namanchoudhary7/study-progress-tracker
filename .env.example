# Backend (backend/.env)
DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/study_tracker
CORS_ORIGINS=http://localhost:5173

# AI agent + MCP server: at least one provider key is required for the agent chat endpoint to work.
# LLM_PROVIDER_PRIORITY is the failover order — the first provider with a key set is tried first.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER_PRIORITY=anthropic,openai,gemini

# Frontend (frontend/.env)
VITE_API_URL=http://localhost:8000/api/v1
