# Backend (backend/.env)
DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/study_tracker
CORS_ORIGINS=http://localhost:5173

# AI agent + MCP server: at least one provider key is required for the agent chat endpoint to work.
# LLM_PROVIDER_PRIORITY is the failover order — the first provider with a key set is tried first.
# Only Gemini is active by default. Anthropic/OpenAI providers already exist in the code
# (app/services/llm/) — to enable one as a fallback, just add its key and prepend/append it to
# LLM_PROVIDER_PRIORITY, e.g. "anthropic,gemini".
GEMINI_API_KEY=
LLM_PROVIDER_PRIORITY=gemini
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Frontend (frontend/.env)
VITE_API_URL=http://localhost:8000/api/v1
